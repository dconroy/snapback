# QuickCap systemd unit TEMPLATE. Not installed by anything in this repo.
# See docs/pi-startup.md before copying it to /etc/systemd/system/.
[Unit]
Description=QuickCap HDMI capture web app
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video audio
WorkingDirectory=/home/pi/quickcap
Environment=QUICKCAP_RUNTIME_DIR=/home/pi/quickcap-runtime
Environment=QUICKCAP_VIDEO_DEVICE=/dev/video0
Environment=QUICKCAP_AUDIO_DEVICE=hw:CARD=C4K,DEV=0
Environment=QUICKCAP_X264_PRESET=ultrafast
ExecStart=/home/pi/quickcap/.venv/bin/python -m quickcap serve --host 0.0.0.0 --port 8000
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
