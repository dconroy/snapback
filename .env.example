# Copy to .env (gitignored) and fill in. Used by scripts/deploy.sh and scripts/pi-ctl.sh
# on your Mac to reach the Pi. Not used by the app itself.

# SSH login for the Pi.
ssh_user=pi
ssh_host=quikcap.local
ssh_port=22

# Optional. Leave empty if you use SSH keys (recommended: ssh-copy-id pi@quikcap.local).
# Quote it if it contains spaces or shell characters: ssh_password='p@ss word'
ssh_password=

# Where the app lives on the Pi.
remote_dir=/home/pi/quickcap
